{
    "dataRoles": [
        {
            "displayName": "类别",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "图片（data:image/... 或 base64）",
            "name": "image",
            "kind": "Grouping"
        },
        {
            "displayName": "小字说明",
            "name": "subtitle",
            "kind": "Grouping"
        },
        {
            "displayName": "主数值",
            "name": "value",
            "kind": "Measure"
        },
        {
            "displayName": "副数值",
            "name": "value2",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "image": {
                        "max": 1
                    },
                    "subtitle": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    },
                    "value2": {
                        "max": 1
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "category"
                            }
                        },
                        {
                            "for": {
                                "in": "image"
                            }
                        },
                        {
                            "for": {
                                "in": "subtitle"
                            }
                        },
                        {
                            "for": {
                                "in": "value"
                            }
                        },
                        {
                            "for": {
                                "in": "value2"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 500
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "colors": {
            "properties": {
                "useTheme": {
                    "type": {
                        "bool": true
                    }
                },
                "accent": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "cardColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "properties": {
                "columns": {
                    "type": {
                        "numeric": true
                    }
                },
                "minWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "gap": {
                    "type": {
                        "numeric": true
                    }
                },
                "radius": {
                    "type": {
                        "numeric": true
                    }
                },
                "imageRatio": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "1",
                                "displayName": "1:1 正方形"
                            },
                            {
                                "value": "0.75",
                                "displayName": "4:3 横图"
                            },
                            {
                                "value": "1.33",
                                "displayName": "3:4 竖图"
                            }
                        ]
                    }
                },
                "imageFit": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "cover",
                                "displayName": "铺满裁切"
                            },
                            {
                                "value": "contain",
                                "displayName": "完整显示"
                            }
                        ]
                    }
                },
                "sort": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "desc",
                                "displayName": "按主数值，从大到小"
                            },
                            {
                                "value": "none",
                                "displayName": "按字段原顺序"
                            }
                        ]
                    }
                }
            }
        },
        "labels": {
            "properties": {
                "showRank": {
                    "type": {
                        "bool": true
                    }
                },
                "topN": {
                    "type": {
                        "numeric": true
                    }
                },
                "showBar": {
                    "type": {
                        "bool": true
                    }
                },
                "unit": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "auto",
                                "displayName": "自动（满 1 万显示「万」）"
                            },
                            {
                                "value": "none",
                                "displayName": "原值"
                            }
                        ]
                    }
                }
            }
        },
        "text": {
            "properties": {
                "useTheme": {
                    "type": {
                        "bool": true
                    }
                },
                "fontFamily": {
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "bold": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        }
    },
    "supportsHighlight": false,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "privileges": []
}