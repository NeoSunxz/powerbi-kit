{
    "dataRoles": [
        {
            "displayName": "类别",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "数值",
            "name": "value",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "value"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "dataPoint": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "properties": {
                "shape": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "square",
                                "displayName": "方块"
                            },
                            {
                                "value": "circle",
                                "displayName": "圆点"
                            }
                        ]
                    }
                },
                "gap": {
                    "type": {
                        "numeric": true
                    }
                },
                "cornerRadius": {
                    "type": {
                        "numeric": true
                    }
                },
                "sort": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "value",
                                "displayName": "按数值，从大到小"
                            },
                            {
                                "value": "none",
                                "displayName": "按字段原顺序"
                            }
                        ]
                    }
                }
            }
        },
        "legend": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "position": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "right",
                                "displayName": "右边"
                            },
                            {
                                "value": "bottom",
                                "displayName": "下面"
                            }
                        ]
                    }
                },
                "showPercent": {
                    "type": {
                        "bool": true
                    }
                },
                "showValue": {
                    "type": {
                        "bool": true
                    }
                },
                "unit": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "auto",
                                "displayName": "自动（满 1 万显示「万」）"
                            },
                            {
                                "value": "none",
                                "displayName": "原值"
                            }
                        ]
                    }
                }
            }
        },
        "text": {
            "properties": {
                "useTheme": {
                    "type": {
                        "bool": true
                    }
                },
                "fontFamily": {
                    "type": {
                        "formatting": {
                            "fontFamily": true
                        }
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "bold": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        }
    },
    "supportsHighlight": false,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "privileges": []
}