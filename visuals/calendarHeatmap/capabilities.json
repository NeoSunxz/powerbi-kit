{
    "dataRoles": [
        {
            "displayName": "日期",
            "name": "date",
            "kind": "Grouping"
        },
        {
            "displayName": "数值",
            "name": "value",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "date": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "date"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 4000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "value"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "colors": {
