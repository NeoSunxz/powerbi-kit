                "useTheme": {
                    "type": {
                        "bool": true
                    }
                },
                "lowColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "highColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "emptyColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "properties": {
                "mondayFirst": {
                    "type": {
                        "bool": true
                    }
                },
                "showMonths": {
                    "type": {
                        "bool": true
                    }
                },
                "cornerRadius": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "text": {
            "properties": {
