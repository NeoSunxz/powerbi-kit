{
    "dataRoles": [
        {
            "displayName": "日期",
            "name": "date",
            "kind": "Grouping"
        },
        {
            "displayName": "数值",
            "name": "value",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "date": {
                        "max": 1
                    },
                    "value": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "date"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 4000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "value"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "objects": {
        "colors": {
            "properties": {
                "lowColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "highColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "emptyColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "properties": {
                "mondayFirst": {
                    "type": {
                        "bool": true
                    }
                },
                "showMonths": {
                    "type": {
                        "bool": true
                    }
                },
                "cornerRadius": {
                    "type": {
                        "numeric": true
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        }
    },
    "supportsHighlight": false,
    "supportsMultiVisualSelection": true,
    "supportsLandingPage": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "privileges": []
}